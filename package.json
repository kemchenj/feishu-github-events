{
  "name": "feishu-github-events",
  "version": "0.1.0",
  "description": "Send GitHub event notifications from GitHub Actions to a Feishu bot.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/mock.ts",
    "test:unit": "tsx --test test/*.test.ts",
    "test:mock": "tsx scripts/mock.ts",
    "test:mock:all": "tsx scripts/mock.ts --all-cases",
    "fixtures:sync": "tsx scripts/sync-fixtures.ts",
    "verify": "npm run typecheck && npm run test:unit && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@octokit/openapi-webhooks-types": "^12.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.1",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
